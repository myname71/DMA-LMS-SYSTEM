# Copy to .env for local development. Set production values in Hostinger's
# server-side environment settings; never commit .env or expose server secrets.

# ─── Supabase PostgreSQL (Prisma — primary app database) ─────────────────────
# Pooled runtime connection (use connection pooler URL from Supabase)
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Direct connection for migrations (db:push / migrate)
DIRECT_URL="postgresql://postgres:YOUR_DATABASE_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# ─── Supabase JS client (optional — Hostinger db.js / REST API) ───────────────
# Project URL: Supabase → Project Settings → API → Project URL
SUPABASE_URL="https://PROJECT_REF.supabase.co"
# Prefer service_role for server-only scripts; use anon only if RLS is configured
SUPABASE_API_KEY="YOUR_SUPABASE_ANON_OR_SERVICE_ROLE_KEY"

# ─── Authentication ──────────────────────────────────────────────────────────
JWT_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
COOKIE_NAME="dma_token"
REFRESH_COOKIE_NAME="dma_refresh"
JWT_EXPIRES_IN="15m"

# ─── Hostinger Node.js application ───────────────────────────────────────────
PORT="5000"
NODE_ENV="development"
FRONTEND_URL="http://localhost:5000"

# ─── Required first-boot administrator accounts ──────────────────────────────
# Set unique strong passwords. Server will not start without these.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
SEED_SUPER_ADMIN_EMAIL="superadmin@example.com"
SEED_SUPER_ADMIN_PASSWORD=""

# Optional password for seeded sample student/instructor accounts.
# Leave empty to avoid creating demo accounts with a shared credential.
SEED_DEMO_PASSWORD=""

# ─── Hostinger mail (optional) ───────────────────────────────────────────────
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="info@digitalmanufacturing.academy"
SMTP_PASS=""
EMAIL_FROM_NAME="DMA Academy"


# ─── Optional AI tutor ───────────────────────────────────────────────────────
GEMINI_API_KEY=""
