// Supabase client — use environment variables. Do NOT commit real keys to the repository.
// Fill SUPABASE_URL and SUPABASE_API_KEY (or SUPABASE_KEY) in your .env or Hostinger environment.

import { createClient } from '@supabase/supabase-js';

const SUPABASE_URL = process.env.SUPABASE_URL || process.env.NEXT_PUBLIC_SUPABASE_URL || '';
const SUPABASE_KEY = process.env.SUPABASE_API_KEY || process.env.SUPABASE_KEY || '';

if (!SUPABASE_URL || !SUPABASE_KEY) {
  console.warn('[supabase] SUPABASE_URL or SUPABASE_KEY is not set. The client may fail.');
}

export const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);
export default supabase;
