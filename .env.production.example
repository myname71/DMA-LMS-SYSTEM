# Production environment example (Hostinger / build server)

# Supabase / Postgres (Prisma)
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Supabase JS
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_API_KEY="YOUR_SUPABASE_SERVICE_ROLE_OR_ANON_KEY"

# Auth & sessions
JWT_SECRET="REPLACE_WITH_32+_CHAR_RANDOM_STRING"
COOKIE_NAME="dma_token"
REFRESH_COOKIE_NAME="dma_refresh"
JWT_EXPIRES_IN="15m"

# Hostinger Node.js app
PORT="5000"
NODE_ENV="production"
FRONTEND_URL="https://your-hostinger-domain.example.com"

# Required first-boot admin accounts (set for seeding only)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="secure_admin_password_here"
SEED_SUPER_ADMIN_EMAIL="superadmin@example.com"
SEED_SUPER_ADMIN_PASSWORD="secure_superadmin_password_here"

# SMTP (optional)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="info@digitalmanufacturing.academy"
SMTP_PASS="your_smtp_password"
EMAIL_FROM_NAME="DMA Academy"

# Optional AI tutor
GEMINI_API_KEY=""
