# ─── DATABASE (SQLite — no external service needed) ───────────────────────────
DATABASE_URL="file:./prisma/dev.db"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-random-32-char-string-abc123xyz"

# ─── SEED ACCOUNTS (created on first npm run db:seed) ────────────────────────
SEED_ADMIN_EMAIL="admin@dma.com"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_SUPER_ADMIN_EMAIL="superadmin@dma.com"
SEED_SUPER_ADMIN_PASSWORD="SuperAdmin123!"

# ─── APP ─────────────────────────────────────────────────────────────────────
NODE_ENV="production"
PORT=3000

# ─── EMAIL / SMTP (Hostinger — get from hPanel > Emails) ─────────────────────
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="noreply@yourdomain.com"
SMTP_PASS="your-hostinger-email-password"
SMTP_FROM="DMA LMS <noreply@yourdomain.com>"

# ─── AI TUTOR (optional — leave blank to disable) ────────────────────────────
GEMINI_API_KEY=""

# ─── PAYMENT (optional — leave blank to disable bKash) ───────────────────────
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
