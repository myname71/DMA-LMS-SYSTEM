generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
// ─── App Users ────────────────────────────────────────────────────────────────
model AppUser {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  password         String?
  role             String   @default("student")
  isApproved       Boolean  @default(true)  @map("is_approved")
  suspended        Boolean  @default(false)
  subscriptionPlan String   @default("free") @map("subscription_plan")
  avatar           String?
  bio              String?
  specialization   String?
  joinedAt         String?  @map("joined_at")
  customRoleId     String?  @map("custom_role_id")
  qualificationDoc     String?  @map("qualification_doc")
  phone                String?
  qualifications       Json?
  badges               Json?
  mustChangePassword   Boolean  @default(false) @map("must_change_password")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("app_users")
}

// ─── App Courses (lessons & quizzes embedded as JSON) ────────────────────────
model AppCourse {
  id              String   @id @default(cuid())
  title           String
  headline        String?
  description     String?
  category        String?
  level           String?
  duration        String?
  instructorId    String?  @map("instructor_id")
  instructorName  String?  @map("instructor_name")
  price           Float    @default(0)
  isFree          Boolean  @default(false) @map("is_free")
  image           String?
  lessons         Json     @default("[]")
  quizzes         Json     @default("[]")
  assignments     Json     @default("[]")
  isPublished     Boolean  @default(false) @map("is_published")
  approvalStatus  String   @default("approved") @map("approval_status")
  rejectionReason String?  @map("rejection_reason")
  enrollmentCount Int      @default(0) @map("enrollment_count")
  ratingAverage   Float    @default(0) @map("rating_average")
  createdAt       String?  @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("app_courses")
}

// ─── App Enrollments ─────────────────────────────────────────────────────────
model AppEnrollment {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  courseId         String   @map("course_id")
  progress         Int      @default(0)
  completedLessons Json     @default("[]") @map("completed_lessons")
  quizAttempts     Json     @default("{}") @map("quiz_attempts")
  enrolledAt       String?  @map("enrolled_at")
  completedAt      String?  @map("completed_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([userId, courseId])
  @@index([userId])
  @@map("app_enrollments")
}

// ─── App Messages ────────────────────────────────────────────────────────────
model AppMessage {
  id         String   @id @default(cuid())
  fromUserId String?  @map("from_user_id")
  toUserId   String?  @map("to_user_id")
  fromName   String?  @map("from_name")
  toName     String?  @map("to_name")
  fromRole   String?  @map("from_role")
  subject    String?
  body       String
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  String?  @map("created_at")

  @@index([toUserId])
  @@map("app_messages")
}

// ─── App Certificates ────────────────────────────────────────────────────────
model AppCertificate {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  courseId  String   @map("course_id")
  certId    String   @map("cert_id")
  issuedAt  String?  @map("issued_at")

  @@index([userId])
  @@map("app_certificates")
}

// ─── App Logs ────────────────────────────────────────────────────────────────
model AppLog {
  id        String   @id @default(cuid())
  text      String
  type      String?
  userId    String?  @map("user_id")
  time      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("app_logs")
}

// ─── App Invites ─────────────────────────────────────────────────────────────
model AppInvite {
  id        String   @id @default(cuid())
  email     String
  role      String
  token     String   @unique
  status    String   @default("pending")
  createdAt String?  @map("created_at")

  @@map("app_invites")
}

// ─── App Custom Roles ────────────────────────────────────────────────────────
model AppCustomRole {
  id          String   @id @default(cuid())
  name        String
  description String?
  permissions Json     @default("[]")
  createdAt   String?  @map("created_at")

  @@map("app_custom_roles")
}

// ─── App Media Library ────────────────────────────────────────────────────────
model AppMediaItem {
  id         String   @id @default(cuid())
  name       String
  dataUrl    String?  @map("data_url")
  type       String?
  usedAs     String?  @map("used_as")
  uploadedAt String?  @map("uploaded_at")

  @@map("app_media_items")
}

// ─── App Bank Accounts ───────────────────────────────────────────────────────
model AppBankAccount {
  id            String   @id @default(cuid())
  instructorId  String   @map("instructor_id")
  bankName      String   @map("bank_name")
  accountName   String   @map("account_name")
  accountNumber String   @map("account_number")
  routingCode   String?  @map("routing_code")
  country       String?

  @@index([instructorId])
  @@map("app_bank_accounts")
}

// ─── App Withdrawal Requests ─────────────────────────────────────────────────
model AppWithdrawalRequest {
  id             String   @id @default(cuid())
  instructorId   String   @map("instructor_id")
  instructorName String?  @map("instructor_name")
  amount         Float
  status         String   @default("pending")
  createdAt      String?  @map("created_at")

  @@index([instructorId])
  @@map("app_withdrawal_requests")
}

// ─── App Assignment Submissions ──────────────────────────────────────────────
model AppAssignmentSubmission {
  id              String   @id @default(cuid())
  assignmentId    String?  @map("assignment_id")
  courseId        String?  @map("course_id")
  assignmentTitle String?  @map("assignment_title")
  courseName      String?  @map("course_name")
  studentId       String?  @map("student_id")
  studentName     String?  @map("student_name")
  text            String
  fileUrl         String?  @map("file_url")
  grade           String?
  feedback        String?
  submittedAt     String?  @map("submitted_at")
  gradedAt        String?  @map("graded_at")
  gradedBy        String?  @map("graded_by")

  @@index([courseId])
  @@index([studentId])
  @@map("app_assignment_submissions")
}

// ─── App Webinar / Platform Posts ────────────────────────────────────────────
model AppWebinarPost {
  id         String   @id @default(cuid())
  title      String
  content    String
  type       String?
  authorId   String?  @map("author_id")
  authorName String?  @map("author_name")
  authorRole String?  @map("author_role")
  tags       Json     @default("[]")
  createdAt  String?  @map("created_at")
  pinned     Boolean  @default(false)
  views      Int      @default(0)

  @@map("app_webinar_posts")
}

// ─── App Quiz Attempts ───────────────────────────────────────────────────────
model AppQuizAttempt {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  courseId    String?  @map("course_id")
  quizId      String?  @map("quiz_id")
  score       Float
  passed      Boolean  @default(false)
  attemptedAt String?  @map("attempted_at")

  @@index([userId])
  @@map("app_quiz_attempts")
}

// ─── App Learning Paths ──────────────────────────────────────────────────────
model AppLearningPath {
  id               String   @id @default(cuid())
  title            String
  description      String?
  category         String?
  courses          Json     @default("[]")
  instructorId     String?  @map("instructor_id")
  instructorName   String?  @map("instructor_name")
  badge            String?
  enrolledStudents Json     @default("[]") @map("enrolled_students")
  createdAt        String?  @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("app_learning_paths")
}

// ─── App Events ──────────────────────────────────────────────────────────────
model AppEvent {
  id        String   @id @default(cuid())
  title     String
  date      String?
  time      String?
  host      String?
  type      String?
  desc      String?
  category  String?
  attendees Json     @default("[]")
  createdAt String?  @map("created_at")

  @@map("app_events")
}

// ─── App CMS Content ─────────────────────────────────────────────────────────
model AppCmsContent {
  id        String   @id @default("main")
  pages     Json     @default("[]")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_cms_content")
}

// ─── App Theme Settings ──────────────────────────────────────────────────────
model AppThemeSetting {
  id        String   @id @default("main")
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_theme_settings")
}

// ─── App Certificate Templates ───────────────────────────────────────────────
model AppCertTemplate {
  id             String   @id @default(cuid())
  name           String
  style          String?
  primaryColor   String?  @map("primary_color")
  accentColor    String?  @map("accent_color")
  headerText     String?  @map("header_text")
  footerText     String?  @map("footer_text")
  signatureLabel String?  @map("signature_label")
  logoEnabled    Boolean  @default(true)  @map("logo_enabled")
  badgeEnabled   Boolean  @default(true)  @map("badge_enabled")
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      String?  @map("created_at")

  @@map("app_cert_templates")
}

// ─── App Subscriptions ───────────────────────────────────────────────────────
model AppSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  plan      String
  status    String   @default("active")
  startDate String?  @map("start_date")
  endDate   String?  @map("end_date")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("app_subscriptions")
}

// ─── App Exams (standalone exams, separate from in-course quizzes) ───────────
model AppExam {
  id              String   @id @default(cuid())
  title           String
  description     String?
  courseId        String?  @map("course_id")
  questions       Json     @default("[]")
  passingScore    Int      @default(70)  @map("passing_score")
  durationMinutes Int      @default(60)  @map("duration_minutes")
  scheduledAt     String?  @map("scheduled_at")
  isPublished     Boolean  @default(false) @map("is_published")
  createdBy       String?  @map("created_by")
  createdByName   String?  @map("created_by_name")
  createdAt       String?  @map("created_at")

  @@index([courseId])
  @@map("app_exams")
}

// ─── App Exam Attempts ───────────────────────────────────────────────────────
model AppExamAttempt {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  examId      String   @map("exam_id")
  examTitle   String?  @map("exam_title")
  score       Float    @default(0)
  passed      Boolean  @default(false)
  correct     Int      @default(0)
  total       Int      @default(0)
  breakdown   Json     @default("[]")
  timeTaken   Int      @default(0) @map("time_taken")
  attemptedAt String?  @map("attempted_at")

  @@index([userId])
  @@map("app_exam_attempts")
}

// ─── App Payments (bKash PGW + bank transfer) ────────────────────────────────
model AppPayment {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  userName    String?  @map("user_name")
  plan        String
  amount      Float    @default(0)
  currency    String   @default("BDT")
  method      String
  status      String   @default("pending")
  providerRef String?  @map("provider_ref")
  reference   String?
  senderName  String?  @map("sender_name")
  raw         Json?
  createdAt   String?  @map("created_at")
  completedAt String?  @map("completed_at")

  @@index([userId])
  @@map("app_payments")
}

model AppCertDownloadHistory {
  id           String  @id @default(cuid())
  certId       String  @map("cert_id")
  userId       String  @map("user_id")
  userName     String? @map("user_name")
  courseTitle  String? @map("course_title")
  downloadedAt String? @map("downloaded_at")

  @@index([userId])
  @@map("app_cert_download_history")
}

model AppStateSnapshot {
  id        String   @id @default("main")
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_state_snapshots")
}
